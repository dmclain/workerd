  services = [
    ( name = "encoding-rust-text-encoder-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "encoding-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "text_decoder_cjk_decoder"]
      )
    ),
  ],
  autogates = [
    "workerd-autogate-rust-text-encoder",
  ],
);
